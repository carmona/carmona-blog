---
import Layout from '../layouts/BlogPost.astro';
import { siteTranslations, type SupportedLang } from '../data/siteTranslations';

interface Props {
	lang: SupportedLang;
}

const { lang } = Astro.props;
const { about } = siteTranslations[lang];

const isEnPrefix = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const resumeHref = lang === 'pt' ? '/resume/pt' : (isEnPrefix ? '/en/resume' : '/resume');
const resumeAltHref = lang === 'pt' ? (isEnPrefix ? '/en/resume' : '/resume') : '/resume/pt';
const resumeAltLangName = lang === 'pt' ? 'English' : 'Português';
const resumeAltHreflang = lang === 'pt' ? 'en' : 'pt';
---

<Layout
	title={about.pageTitle}
	description={about.pageDescription}
	pubDate={new Date('November 18 2026')}
	heroImage="/filipe-carmona.jpg"
	heroImageAlt={about.heroImageAlt}
	lang={lang}
>
	<p set:html={about.intro} />

	<h2>{about.backgroundHeading}</h2>
	<p set:html={about.backgroundText} />

	<h2>{about.highlightsHeading}</h2>
	<ul>
		{
			about.highlights.map((h) => (
				<li>
					<strong>{h.title}</strong> {h.content}
				</li>
			))
		}
	</ul>

	<h2>{about.learningHeading}</h2>
	<p set:html={about.learningText} />

	<h2>{about.languagesHeading}</h2>
	<p>{about.languagesIntro}</p>
	<ul>
		{
			about.languagesList.map((l) => (
				<li>
					<strong>{l.name}:</strong> {l.level}
				</li>
			))
		}
	</ul>

	<h2>{about.contactHeading}</h2>
	<p>{about.contactIntro}</p>
	<ul>
		<li>
			{lang === 'pt' ? '📄 Acesse meu ' : '📄 Check out my '}
			<strong><a href={resumeHref}>{about.contactResumeLink}</a></strong>
			{lang === 'pt' ? ' (também disponível em ' : ' (also available in '}
			<strong><a href={resumeAltHref} hreflang={resumeAltHreflang}>{resumeAltLangName}</a></strong>).
		</li>
		<li>
			{lang === 'pt' ? '💼 Conecte-se comigo no ' : '💼 Connect with me on '}
			<strong>
				<a href="https://linkedin.com/in/filipecarmona" target="_blank" rel="noopener noreferrer">
					LinkedIn
				</a>
			</strong>
			.
		</li>
		<li>
			{lang === 'pt' ? '💻 Explore meus projetos e repositórios de código aberto no ' : '💻 Explore my open-source work and repositories on '}
			<strong>
				<a href="https://github.com/carmona" target="_blank" rel="noopener noreferrer">
					GitHub
				</a>
			</strong>
			.
		</li>
		<li>
			{lang === 'pt' ? '🗺️ Acompanhe minha trajetória técnica no ' : '🗺️ Follow my technical path on '}
			<strong>
				<a href="https://roadmap.sh/u/carmona" target="_blank" rel="noopener noreferrer">
					Roadmap.sh
				</a>
			</strong>
			.
		</li>
		<li>
			{lang === 'pt' ? '✉️ Envie uma mensagem por e-mail para ' : '✉️ Reach out via email at '}
			<a href={`mailto:${about.contactEmail}`}>{about.contactEmail}</a>.
		</li>
	</ul>
</Layout>
