---
import HeaderLink from './HeaderLink.astro';
import {
	siteTranslations,
	getCurrentLang,
	getLocalizedPath,
	type SupportedLang,
} from '../data/siteTranslations';

interface Props {
	lang?: SupportedLang;
}

const { lang } = Astro.props;
const currentLang = lang || getCurrentLang(Astro.url.pathname);
const t = siteTranslations[currentLang];

const isEnPrefix = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const homeUrl = currentLang === 'pt' ? '/pt' : (isEnPrefix ? '/en' : '/');
const aboutUrl = currentLang === 'pt' ? '/pt/about' : (isEnPrefix ? '/en/about' : '/about');
const resumeUrl = currentLang === 'pt' ? '/pt/resume' : (isEnPrefix ? '/en/resume' : '/resume');

const supportedLangs: SupportedLang[] = ['en', 'pt'];
---

<header class="site-header">
	<div class="header-inner">
		<!-- Brand & Actions Row -->
		<div class="brand-bar">
			<h2><a href={homeUrl} class="site-title">{t.ui.siteTitle}</a></h2>

			<div class="header-actions">
				<!-- Language Switcher (Compact, accessible in header bar) -->
				<nav aria-label={t.ui.languageNavLabel} class="lang-nav">
					<span class="globe-icon" aria-hidden="true">🌐</span>
					<span class="sr-only">{t.ui.languageNavLabel}:</span>
					<ul class="lang-list">
						{
							supportedLangs.map((l) => {
								const href = getLocalizedPath(l, Astro.url.pathname);
								const isActive = currentLang === l;
								return (
									<li>
										<a
											href={href}
											lang={l}
											hreflang={l}
											aria-current={isActive ? 'page' : undefined}
											class:list={['lang-link', { active: isActive }]}
											title={t.ui.languages[l]}
										>
											{t.ui.shortLanguages[l]}
										</a>
									</li>
								);
							})
						}
					</ul>
				</nav>

				<!-- Theme Toggle Button -->
				<button
					type="button"
					id="theme-toggle-btn"
					class="theme-toggle-btn"
					aria-label={t.ui.theme.toggleAria}
					title={t.ui.theme.toggleAria}
				>
					<!-- Sun icon (shown in dark mode) -->
					<svg
						class="icon-sun"
						viewBox="0 0 24 24"
						width="19"
						height="19"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="4" fill="currentColor"></circle>
						<path
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
						></path>
					</svg>
					<!-- Moon icon (shown in light mode) -->
					<svg
						class="icon-moon"
						viewBox="0 0 24 24"
						width="19"
						height="19"
						aria-hidden="true"
					>
						<path
							fill="currentColor"
							d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
						></path>
					</svg>
				</button>

				<!-- Hamburger Menu Toggle Button (mobile only) -->
				<button
					type="button"
					id="menu-toggle-btn"
					class="menu-toggle-btn"
					aria-expanded="false"
					aria-controls="site-navigation"
					aria-label={t.ui.nav.openMenu}
					data-open-label={t.ui.nav.openMenu}
					data-close-label={t.ui.nav.closeMenu}
				>
					<svg
						class="icon-menu"
						viewBox="0 0 24 24"
						aria-hidden="true"
						width="24"
						height="24"
					>
						<path
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							d="M4 6h16M4 12h16M4 18h16"
						></path>
					</svg>
					<svg
						class="icon-close"
						viewBox="0 0 24 24"
						aria-hidden="true"
						width="24"
						height="24"
					>
						<path
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							d="M6 6l12 12M6 18L18 6"
						></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Nav Landmark (Inline on desktop, Dropdown on mobile) -->
		<nav id="site-navigation" aria-label="Primary" class="site-nav">
			<ul class="nav-links">
				<li><HeaderLink href={homeUrl}>{t.ui.nav.home}</HeaderLink></li>
				<!-- <li><HeaderLink href={currentLang === 'pt' ? '/pt/blog' : '/blog'}>{t.ui.nav.blog}</HeaderLink></li> -->
				<li><HeaderLink href={aboutUrl}>{t.ui.nav.about}</HeaderLink></li>
				<li><HeaderLink href={resumeUrl}>{t.ui.nav.resume}</HeaderLink></li>
			</ul>

			<!-- Social Links -->
			<div class="social-links">
				<a
					href="https://github.com/carmona"
					target="_blank"
					rel="noopener noreferrer"
					title="GitHub"
				>
					<span class="sr-only">{t.ui.footer.githubAria}</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
				<a
					href="https://linkedin.com/in/filipecarmona"
					target="_blank"
					rel="noopener noreferrer"
					title="LinkedIn"
				>
					<span class="sr-only">{t.ui.footer.linkedinAria}</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
						<path
							fill="currentColor"
							d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
						></path>
					</svg>
				</a>
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		margin: 0;
		padding: 0 1.25em;
		background: var(--bg-surface);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 8%);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.header-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 1.1em;
	}

	.site-title {
		text-decoration: none;
		color: rgb(var(--black));
		font-weight: 700;
		transition: color 0.15s ease;
	}

	.site-title:hover {
		color: var(--accent);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	/* Language Switcher */
	.lang-nav {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border-color);
		padding: 0.2rem 0.35rem;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 600;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.globe-icon {
		font-size: 0.85rem;
		line-height: 1;
		margin-left: 0.15rem;
	}

	.lang-list {
		display: inline-flex;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 0.15rem;
	}

	.lang-link {
		display: inline-block;
		padding: 0.18rem 0.45rem;
		border-radius: 9999px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.lang-link:hover {
		color: rgb(var(--black));
		background-color: rgba(var(--gray), 20%);
	}

	.lang-link.active {
		background-color: var(--accent);
		color: #ffffff;
		font-weight: 700;
	}

	/* Theme Toggle Button */
	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		background: var(--bg-elevated);
		border: 1px solid var(--border-color);
		border-radius: 9999px;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.theme-toggle-btn:hover {
		background-color: rgba(var(--gray), 20%);
		color: var(--accent);
	}

	.theme-toggle-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* Icon display states based on active theme */
	.theme-toggle-btn .icon-sun {
		display: none;
	}
	.theme-toggle-btn .icon-moon {
		display: block;
	}

	:root[data-theme="dark"] .theme-toggle-btn .icon-sun,
	:root:not([data-theme="light"]):has(> head > meta[name="color-scheme"][content="dark"]) .theme-toggle-btn .icon-sun {
		display: block;
	}
	:root[data-theme="dark"] .theme-toggle-btn .icon-moon,
	:root:not([data-theme="light"]):has(> head > meta[name="color-scheme"][content="dark"]) .theme-toggle-btn .icon-moon {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .theme-toggle-btn .icon-sun {
			display: block;
		}
		:root:not([data-theme="light"]) .theme-toggle-btn .icon-moon {
			display: none;
		}
	}

	/* Menu Toggle Button (hidden on desktop) */
	.menu-toggle-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		background: var(--bg-elevated);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		color: rgb(var(--black));
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.menu-toggle-btn:hover {
		background-color: rgba(var(--gray), 20%);
	}

	.menu-toggle-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.menu-toggle-btn .icon-close {
		display: none;
	}

	.menu-toggle-btn[aria-expanded="true"] .icon-menu {
		display: none;
	}

	.menu-toggle-btn[aria-expanded="true"] .icon-close {
		display: block;
	}

	/* Desktop Navigation */
	.site-nav {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 0.25em;
	}

	.nav-links :global(a) {
		padding: 1em 0.6em;
		color: rgb(var(--gray-dark));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.nav-links :global(a:hover) {
		color: rgb(var(--black));
	}

	.nav-links :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		color: rgb(var(--gray));
		padding: 0.25em;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.social-links a:hover {
		color: var(--accent);
	}

	/* Mobile Styles (max-width: 720px) */
	@media (max-width: 720px) {
		.site-header {
			padding: 0.5em 1em;
		}

		.header-inner {
			flex-direction: column;
			align-items: stretch;
		}

		.brand-bar {
			width: 100%;
			min-height: 48px;
		}

		.menu-toggle-btn {
			display: inline-flex;
			width: 44px;
			height: 44px;
		}

		.theme-toggle-btn {
			width: 44px;
			height: 44px;
		}

		/* Mobile dropdown */
		.site-nav {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5em 0 1em 0;
			border-top: 1px solid var(--border-color);
			margin-top: 0.5em;
		}

		.site-nav.is-open {
			display: flex;
			animation: navSlideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		}

		@keyframes navSlideDown {
			from {
				opacity: 0;
				transform: translateY(-8px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.nav-links {
			flex-direction: column;
			align-items: stretch;
			gap: 0.25em;
		}

		.nav-links li {
			width: 100%;
		}

		.nav-links :global(a) {
			display: block;
			width: 100%;
			min-height: 48px;
			padding: 0.8em 0.85em;
			font-size: 1.05em;
			border-bottom: none;
			border-left: 4px solid transparent;
			border-radius: 6px;
			box-sizing: border-box;
		}

		.nav-links :global(a:hover) {
			background-color: var(--bg-elevated);
		}

		.nav-links :global(a.active) {
			border-left-color: var(--accent);
			background-color: var(--bg-elevated);
			color: var(--accent);
			font-weight: 700;
		}

		.social-links {
			justify-content: center;
			padding-top: 0.85em;
			margin-top: 0.75em;
			border-top: 1px solid var(--border-color);
		}
	}
</style>

<script>
	function setupHeader() {
		// --- Mobile Navigation Menu ---
		const menuBtn = document.getElementById('menu-toggle-btn');
		const nav = document.getElementById('site-navigation');
		if (menuBtn && nav) {
			const openLabel = menuBtn.getAttribute('data-open-label') || 'Open navigation menu';
			const closeLabel = menuBtn.getAttribute('data-close-label') || 'Close navigation menu';

			function toggleMenu(forceOpen?: boolean) {
				const isOpen =
					typeof forceOpen === 'boolean'
						? forceOpen
						: menuBtn?.getAttribute('aria-expanded') !== 'true';

				menuBtn?.setAttribute('aria-expanded', String(isOpen));
				menuBtn?.setAttribute('aria-label', isOpen ? closeLabel : openLabel);
				nav?.classList.toggle('is-open', isOpen);
			}

			menuBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleMenu();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
					toggleMenu(false);
					menuBtn.focus();
				}
			});

			document.addEventListener('click', (e) => {
				if (
					menuBtn.getAttribute('aria-expanded') === 'true' &&
					!menuBtn.closest('header')?.contains(e.target as Node)
				) {
					toggleMenu(false);
				}
			});

			nav.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					toggleMenu(false);
				});
			});
		}

		// --- Theme Toggle Control ---
		const themeBtn = document.getElementById('theme-toggle-btn');
		if (themeBtn) {
			function getResolvedTheme() {
				const explicit = document.documentElement.getAttribute('data-theme');
				if (explicit === 'dark' || explicit === 'light') return explicit;
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}

			themeBtn.addEventListener('click', () => {
				const current = getResolvedTheme();
				const target = current === 'dark' ? 'light' : 'dark';
				const systemPref = window.matchMedia('(prefers-color-scheme: dark)').matches
					? 'dark'
					: 'light';

				if (target === systemPref) {
					// Reverting to system preference
					try {
						localStorage.removeItem('theme');
					} catch (e) {}
					document.documentElement.removeAttribute('data-theme');
					const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
					if (meta) meta.content = 'light dark';
				} else {
					// Storing explicit preference
					try {
						localStorage.setItem('theme', target);
					} catch (e) {}
					document.documentElement.setAttribute('data-theme', target);
					const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
					if (meta) meta.content = target;
				}
			});

			// Multi-tab synchronization
			window.addEventListener('storage', (e) => {
				if (e.key === 'theme') {
					if (e.newValue === 'dark' || e.newValue === 'light') {
						document.documentElement.setAttribute('data-theme', e.newValue);
						const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
						if (meta) meta.content = e.newValue;
					} else {
						document.documentElement.removeAttribute('data-theme');
						const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
						if (meta) meta.content = 'light dark';
					}
				}
			});
		}
	}

	setupHeader();
	document.addEventListener('astro:page-load', setupHeader);
</script>
