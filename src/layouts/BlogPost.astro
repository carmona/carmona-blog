---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import {
	getCurrentLang,
	getLocalizedPath,
	type SupportedLang,
} from '../data/siteTranslations';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	heroImageAlt?: string;
	lang?: SupportedLang;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt = '',
	lang,
} = Astro.props;

const currentLang = lang || getCurrentLang(Astro.url.pathname);
const htmlLang = currentLang === 'pt' ? 'pt-BR' : 'en';

const enAlt = getLocalizedPath('en', Astro.url.pathname);
const ptAlt = getLocalizedPath('pt', Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={title} description={description} />
		<link rel="alternate" hreflang="en" href={enAlt} />
		<link rel="alternate" hreflang="pt" href={ptAlt} />
		<link rel="alternate" hreflang="x-default" href={enAlt} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header lang={currentLang} />
		<main id="main-content">
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={heroImageAlt} />}
				</div>
				<div class="prose">
					<div class="title">
						{
							pubDate && (
								<div class="date">
									<FormattedDate date={pubDate} />
									{updatedDate && (
										<div class="last-updated-on">
											{currentLang === 'pt' ? 'Última atualização em ' : 'Last updated on '}
											<FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer lang={currentLang} />
	</body>
</html>
