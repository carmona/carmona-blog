---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Software Engineer & Technical Lead`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1>👋 Hi, I'm Filipe</h1>
			<p class="tagline">
				<strong>Software Engineer • Frontend Specialist • Technical Lead</strong>
			</p>
			<p>
				Welcome to my personal corner of the web. This is where I post everything worth talking about.
			</p>

			<hr />

			<section aria-labelledby="highlights-heading">
				<h2 id="highlights-heading">What I Do</h2>
				<ul class="highlights-list">
					<li>
						<strong>Frontend Architecture &amp; Design Systems:</strong> Deep expertise in React, Angular, TypeScript, Web Components, and WCAG 2.1 accessibility. Led the phased, zero-downtime modernization of a 50-screen enterprise platform.
					</li>
					<li>
						<strong>Applied AI &amp; Real-Time Systems:</strong> Deployed Google Dialogflow conversational AI, live document retrieval, sentiment scoring, and LLM orchestration powering 30,000+ daily contact center agents across 10+ enterprise clients.
					</li>
					<li>
						<strong>Healthcare SaaS &amp; Scale:</strong> Scaled applications from hundreds of practices to over 8,000 dental clinics across North America, building HIPAA-compliant electronic records using the HL7 FHIR standard.
					</li>
					<li>
						<strong>Cloud &amp; DevOps Governance:</strong> Co-managed zero-downtime blue/green Kubernetes releases on AWS, created private CLI developer tooling that reduced onboarding time by ~70%, and enforced strict security gates with SonarQube and Black Duck.
					</li>
				</ul>
			</section>

			<hr />

			<section aria-labelledby="quick-links-heading">
				<h2 id="quick-links-heading">Explore</h2>
				<p>
					Interested in my career history, skill set, and past projects?
				</p>
				<ul>
					<li>
						📄 View my complete <strong><a href="/resume">Technical Resume</a></strong> (also available in <strong><a href="/resume/pt">Português</a></strong>).
					</li>
					<li>
						🧑‍💻 Read more on the <strong><a href="/about">About Me</a></strong> page.
					</li>
					<!-- <li>
						✍️ Check out articles and updates in the <strong><a href="/blog">Blog</a></strong>.
					</li> -->
					<li>
						🌐 Connect with me on <strong><a href="https://linkedin.com/in/filipecarmona" target="_blank" rel="noopener noreferrer">LinkedIn</a></strong> or check out my work on <strong><a href="https://github.com/carmona" target="_blank" rel="noopener noreferrer">GitHub</a></strong>.
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tagline {
		font-size: 1.15em;
		color: var(--accent);
		margin-bottom: 1.25em;
	}

	.highlights-list {
		padding-left: 1.25em;
	}

	.highlights-list li {
		margin-bottom: 1em;
	}

	hr {
		border: 0;
		border-top: 1px solid rgba(var(--gray-light), 80%);
		margin: 2em 0;
	}
</style>
